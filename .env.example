# ==============================================================================
# NEXUS LLM GATEWAY - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Primary High-Speed Provider (Groq LPU)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Secondary Fallback Provider (OpenRouter)
# Obtain from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Distributed Rate Limiting & Cache (Optional)
# If omitted or if Redis is unreachable, in-memory dual-engine fallback is used automatically
REDIS_URL=redis://localhost:6379

# Gateway Server Settings
PORT=8000
HOST=0.0.0.0
